package dev.wukong.client;

import net.minecraft.client.Minecraft;
import net.minecraft.client.gui.GuiGraphicsExtractor;
import net.minecraft.core.BlockPos;
import net.minecraft.world.item.ItemStack;
import java.util.ArrayList;
import java.util.List;

/** Compact HUD without custom inventory hooks or client-side network messages. */
public final class QualityHud {
    private static Object level;
    private static boolean dead;

    public static void tick(Minecraft mc) {
        if (mc.level != level) { level=mc.level; dead=false; }
        if (mc.player == null || mc.level==null) return;
        BenchConfig cfg=BenchConfig.INSTANCE;
        boolean nowDead=mc.player.isDeadOrDying();
        if (cfg.deathMarkerEnabled && nowDead && !dead) {
            var p=mc.player.blockPosition();
            cfg.lastDeath=new BenchConfig.Waypoint("Last death", mc.level.dimension().identifier().toString(), p.getX(),p.getY(),p.getZ());
            cfg.save();
        }
        dead=nowDead;
    }

    public static void addCurrentPosition(Minecraft mc) {
        if (mc.level==null || mc.player==null) return;
        var p=mc.player.blockPosition();
        var cfg=BenchConfig.INSTANCE;
        cfg.waypoints.add(new BenchConfig.Waypoint("Waypoint " + (cfg.waypoints.size()+1),
                mc.level.dimension().identifier().toString(),p.getX(),p.getY(),p.getZ()));
        // Keep user config bounded and stable.
        if (cfg.waypoints.size()>64) cfg.waypoints.remove(0);
        cfg.save();
    }

    public static void draw(GuiGraphicsExtractor g) {
        Minecraft mc=Minecraft.getInstance();
        BenchConfig cfg=BenchConfig.INSTANCE;
        if (mc.player==null || mc.level==null) return;
        int x=Math.max(4,g.guiWidth()-210), y=10;
        String dim=mc.level.dimension().identifier().toString();
        if (cfg.deathMarkerEnabled && cfg.lastDeath!=null && dim.equals(cfg.lastDeath.dimension)) {
            var d=cfg.lastDeath;
            String t="Last death: "+d.x+" / "+d.y+" / "+d.z+" ("+distance(mc,d)+"m)";
            g.text(mc.font,t,x,y,0xFFFF8080,true); y+=12;
        }
        if (cfg.waypointsEnabled && cfg.waypoints!=null) {
            int shown=0;
            for (var d:cfg.waypoints) {
                if (shown>=5) break;
                if (!dim.equals(d.dimension)) continue;
                String t=d.name+": "+d.x+","+d.y+","+d.z+" ("+distance(mc,d)+"m)";
                g.text(mc.font,t,x,y,0xFF77DDFF,true);
                y+=12; shown++;
            }
        }
        if (cfg.inventoryHudEnabled) {
            int bx=8,by=g.guiHeight()-54;
            ItemStack hand=mc.player.getMainHandItem();
            if (!hand.isEmpty()) {
                String text=hand.getHoverName().getString()+" x"+hand.getCount();
                if (hand.isDamageableItem()) text+=" ("+(hand.getMaxDamage()-hand.getDamageValue())+"/"+hand.getMaxDamage()+")";
                g.text(mc.font,text,bx,by,0xFFE9E9E9,true); by+=12;
            }
            for (ItemStack armor:mc.player.getArmorSlots()) {
                if (armor.isEmpty() || !armor.isDamageableItem()) continue;
                String text=armor.getHoverName().getString()+": "+(armor.getMaxDamage()-armor.getDamageValue());
                g.text(mc.font,text,bx,by,0xFFC7E5FF,true); by+=12;
            }
        }
    }
    private static int distance(Minecraft mc, BenchConfig.Waypoint p) {
        BlockPos here=mc.player.blockPosition();
        double dx=(double)here.getX()-p.x, dy=(double)here.getY()-p.y, dz=(double)here.getZ()-p.z;
        return (int)Math.round(Math.sqrt(dx*dx+dy*dy+dz*dz));
    }
    private QualityHud(){}
}
